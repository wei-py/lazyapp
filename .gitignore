# Dependencies
node_modules/

# Test and coverage output
coverage/

# Standalone release output
/dist/

# Managed App data. Running `bun run dev` from this source directory would create
# ./lazyapp/ with plaintext credentials; the workspace carries its own
# `lazyapp/.gitignore` containing `*` (docs/spec.md section 9).
/lazyapp/

# Workspace staging directory, created at the project root during initialization.
.lazyapp-stage-*/

# Local environment files with credentials
.env
.env.*

# Assistant-skill assets: managed by the agent environment, not application source.
# `.claude/skills/*` are symlinks into `.agents/skills/*`; skills-lock.json pins
# their versions for the local harness only.
.agents/
.claude/
skills-lock.json

# Editor and OS noise
.DS_Store
._*
{
  "name": "lazyapp",
  "type": "module",
  "version": "2.1.0",
  "private": true,
  "packageManager": "bun@1.4.2",
  "bin": {
    "lazyapp": "./src/main.js"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "scripts": {
    "build": "bun scripts/build.js",
    "smoke:release": "bun scripts/smoke-release.js",
    "smoke:source": "bun scripts/smoke-release.js --source",
    "dev": "bun src/main.js",
    "web": "bun src/main.js web",
    "lint": "bun --bun eslint .",
    "lint:fix": "bun --bun eslint . --fix",
    "format": "bunx --bun oxfmt@latest . && bun run lint:fix",
    "test": "bun test"
  },
  "dependencies": {
    "@opentui/core": "0.5.11",
    "string-width": "7.2.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "9.5.1",
    "@types/node": "26.6.5",
    "eslint": "10.10.0"
  }
}
